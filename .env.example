APP_NAME="Let's Talk About"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Douala
APP_URL=http://localhost:8000
APP_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Base de donnees : PostgreSQL ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lta_webapp
DB_USERNAME=lta_user
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Emails ---
# En local sans cle Resend, laisser MAIL_MAILER=log : les emails sont ecrits
# dans storage/logs/laravel.log. Avec Resend (https://resend.com/api-keys) :
# MAIL_MAILER=resend
# RESEND_KEY=re_xxx
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@letstalkabout.local"
MAIL_FROM_NAME="${APP_NAME}"

# Adresse(s) du Bureau Executif notifiees a chaque nouvelle demande d'adhesion
# (liste separee par des virgules)
LTA_BUREAU_NOTIFICATION_EMAILS=letstaboutableta@gmail.com

VITE_APP_NAME="${APP_NAME}"
